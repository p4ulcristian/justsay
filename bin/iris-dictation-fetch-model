#!/usr/bin/env bash
# Download the speech model, NVIDIA Canary-1B-v2 in ONNX, into
# ~/.local/share/iris-dictation/models/canary-1b-v2.
#
# The files go straight into that plain directory, not the Hugging Face
# cache: onnxruntime will not follow the cache's symlinks to the weights.
set -euo pipefail
cd "$(dirname "$(dirname "$(readlink -f "$0")")")"

REPO="istupakov/canary-1b-v2-onnx"
DEST="$HOME/.local/share/iris-dictation/models/canary-1b-v2"
FILES="encoder-model.onnx encoder-model.onnx.data decoder-model.onnx
       vocab.txt config.json"

echo "Fetching $REPO into $DEST ..."
mkdir -p "$DEST"
.venv/bin/python - "$REPO" "$DEST" $FILES <<'PY'
import sys
from huggingface_hub import snapshot_download
repo, dest, *files = sys.argv[1:]
snapshot_download(repo, allow_patterns=files, local_dir=dest)
PY
echo "Model installed in $DEST"
du -sh "$DEST"
