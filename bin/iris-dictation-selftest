#!/usr/bin/env bash
# Run the sample clips through the running daemon and print what it heard.
# Nothing is typed; the overlay shows each result.
set -u
cd "$(dirname "$(dirname "$(readlink -f "$0")")")" || exit 1

if ! ./bin/iris-dictation ping >/dev/null 2>&1; then
  echo "daemon is not running: systemctl --user start iris-dictation" >&2
  exit 1
fi

for wav in testwav/*.wav; do
  echo "--- $wav"
  ./bin/iris-dictation transcribe "$wav"
done
echo
echo "Expected text: testwav/SOURCES.md"
